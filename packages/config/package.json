{
  "name": "@ai4u/config",
  "version": "0.2.0",
  "description": "Config compartida del ecosistema superAI: contrato de variables de entorno (nombres canónicos, alias, llaves por tenant) y lectura de valores no-secretos desde system_settings de Mission Control con fallback a process.env.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    }
  },
  "typesVersions": {
    "*": {
      "env": [
        "dist/env.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^2"
  }
}
